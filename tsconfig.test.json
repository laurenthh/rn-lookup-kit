{
  // Type-checks tests, scripts and config the way they are run (Vitest and
  // Bun bundle-style resolution); never emits.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    // The README example imports the package by name; check it against src.
    "paths": {
      "rn-lookup-kit": ["./src/index.ts"],
      "rn-lookup-kit/*": ["./src/*/index.ts"]
    }
  },
  "include": ["src", "__tests__", "scripts", "examples", "vitest.config.ts"]
}
